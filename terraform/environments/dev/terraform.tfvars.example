# Dev environment variables
# Copy to terraform.tfvars and set values or rely on GitHub Actions secrets

do_token             = "your-digitalocean-token-here"
cloudflare_api_token = "your-cloudflare-api-token-here"
cloudflare_zone_id   = "your-cloudflare-zone-id-here"

region        = "sfo2"
droplet_size  = "s-1vcpu-2gb"
database_size = "db-s-1vcpu-1gb"

# DO SSH key fingerprints to seed into the droplet at creation.
# pausatf-dev-deploy key (DO ID 54308918) — used by deploy-dev workflow (DEV_SSH_PRIVATE_KEY secret).
# Add additional keys (e.g. developer laptops) as needed.
ssh_key_fingerprints = ["41:de:28:dd:8b:51:aa:f6:04:b3:37:18:64:be:c2:3e"]

environment = "dev"
