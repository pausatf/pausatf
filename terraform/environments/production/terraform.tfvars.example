# Production Environment Variables
# Copy this file to terraform.tfvars and fill in actual values
# NEVER commit terraform.tfvars to git!

# Required - Get from DigitalOcean
do_token = "your-digitalocean-token-here"

# Required - Get from Cloudflare
cloudflare_api_token = "your-cloudflare-api-token-here"

# Production Configuration
region        = "sfo2"
droplet_size  = "s-2vcpu-4gb"
droplet_image = "ubuntu-26-04-x64"
database_size = "db-s-1vcpu-1gb"

# SSH Configuration
ssh_public_key = "ssh-ed25519 AAAA... your-public-key-here"

ssh_allowed_ips = [
  "100.64.0.0/10", # Tailscale; keep this for admin access through the tailnet.
  # Add the current administrator source CIDR from the production DO firewall.
  # The production configuration rejects an empty list and unrestricted CIDRs.
]

# Monitoring alerts
alert_email_addresses = [
  "ops@pausatf.org",
]
