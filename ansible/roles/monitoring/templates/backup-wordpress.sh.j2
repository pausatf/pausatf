#!/bin/bash
# WordPress Backup Script
# Managed by Ansible

set -euo pipefail

BACKUP_DIR="{{ backup_destination }}"
RETENTION_DAYS="{{ backup_retention_days }}"
DATE=$(date +%Y%m%d-%H%M%S)
LOG_FILE="/var/log/wordpress-backup.log"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

cleanup() {
    rm -f /root/.my-backup-*.cnf
}

log "Starting WordPress backup..."

# Create backup directory
mkdir -p "$BACKUP_DIR"

# Clean up all temp credential files on exit
trap cleanup EXIT
trap 'log "Backup failed at line ${LINENO}"' ERR

{% for wp in wordpress_installs %}
# Backup {{ wp.name }}
log "Backing up {{ wp.name }}..."

DB_HOST_RAW='{{ wp.db_host | default("localhost") }}'
DB_HOST="$DB_HOST_RAW"
DB_PORT='{{ wp.db_port | default("") }}'
DB_SSL_MODE='{{ wp.db_ssl_mode | default("") }}'

if [[ -z "$DB_PORT" && "$DB_HOST_RAW" == *:* ]]; then
    CANDIDATE_PORT="${DB_HOST_RAW##*:}"
    CANDIDATE_HOST="${DB_HOST_RAW%:*}"
    if [[ "$CANDIDATE_PORT" =~ ^[0-9]+$ ]]; then
        DB_HOST="$CANDIDATE_HOST"
        DB_PORT="$CANDIDATE_PORT"
    fi
fi

if [[ -z "$DB_SSL_MODE" && "$DB_HOST" != "localhost" && "$DB_HOST" != "127.0.0.1" && "$DB_HOST" != "::1" ]]; then
    DB_SSL_MODE="REQUIRED"
fi

log "Database backup connection for {{ wp.name }}: host=${DB_HOST} port=${DB_PORT:-default} ssl_mode=${DB_SSL_MODE:-default}"

# Database backup — credentials via temp file to avoid MYSQL_PWD env exposure
_MYCNF=$(mktemp /root/.my-backup-XXXXXX.cnf)
chmod 600 "$_MYCNF"
printf '[client]\nuser=%s\npassword=%s\n' '{{ wp.db_user }}' '{{ wp.db_password }}' > "$_MYCNF"
MYSQLDUMP_ARGS=(--defaults-extra-file="$_MYCNF" --host="$DB_HOST")
if [[ -n "$DB_PORT" ]]; then
    MYSQLDUMP_ARGS+=(--port="$DB_PORT")
fi
if [[ -n "$DB_SSL_MODE" ]]; then
    MYSQLDUMP_ARGS+=(--ssl-mode="$DB_SSL_MODE")
fi
mysqldump "${MYSQLDUMP_ARGS[@]}" '{{ wp.db_name }}' | gzip > "$BACKUP_DIR/{{ wp.name }}-db-$DATE.sql.gz"
rm -f "$_MYCNF"

# Files backup
tar -czf "$BACKUP_DIR/{{ wp.name }}-files-$DATE.tar.gz" -C "$(dirname '{{ wp.path }}')" "$(basename '{{ wp.path }}')" --exclude="wp-content/cache" --exclude="wp-content/uploads/cache"

log "{{ wp.name }} backup complete"

{% endfor %}

{% set file_only_items = (backup_items | default([])) | rejectattr('db_name', 'defined') | list %}
{% if file_only_items %}
# Backup non-WordPress file paths (no database)
{% for item in file_only_items %}
log "Backing up {{ item.name }} (files only)..."
tar -czf "$BACKUP_DIR/{{ item.name }}-files-$DATE.tar.gz" \
    -C "$(dirname '{{ item.path }}')" "$(basename '{{ item.path }}')"
log "{{ item.name }} backup complete"

{% endfor %}
{% endif %}
# Cleanup old backups
log "Cleaning up backups older than $RETENTION_DAYS days..."
find "$BACKUP_DIR" -name "*.gz" -mtime +"$RETENTION_DAYS" -delete

# Safety net: keep only the {{ backup_keep_count | default(3) }} most recent of each type
{% for wp in wordpress_installs %}
ls -t "$BACKUP_DIR"/{{ wp.name }}-files-*.tar.gz 2>/dev/null | tail -n +{{ (backup_keep_count | default(3)) + 1 }} | xargs -r rm -f
ls -t "$BACKUP_DIR"/{{ wp.name }}-db-*.sql.gz 2>/dev/null | tail -n +{{ (backup_keep_count | default(3)) + 1 }} | xargs -r rm -f
{% endfor %}
{% for item in (backup_items | default([])) | rejectattr('db_name', 'defined') | list %}
ls -t "$BACKUP_DIR"/{{ item.name }}-files-*.tar.gz 2>/dev/null | tail -n +{{ (backup_keep_count | default(3)) + 1 }} | xargs -r rm -f
{% endfor %}

# Show backup sizes
log "Backup sizes:"
ls -lh "$BACKUP_DIR"/*-$DATE* 2>/dev/null | tee -a "$LOG_FILE" || true

log "Backup complete!"
