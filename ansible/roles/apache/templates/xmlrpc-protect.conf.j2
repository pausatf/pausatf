# Block xmlrpc.php except from Jetpack/Automattic IPs
# Managed by Ansible - Do not edit manually
# Jetpack IPs auto-refreshed from https://jetpack.com/ips-v4.txt
<Files xmlrpc.php>
{% for cidr in jetpack_ip_ranges %}
    Require ip {{ cidr }}
{% endfor %}
    Header always set Cache-Control "private, no-store, no-cache, must-revalidate, max-age=0"
    Header always set CF-Cache-Control "no-store"
</Files>
