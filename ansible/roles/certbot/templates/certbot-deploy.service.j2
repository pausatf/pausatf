[Unit]
Description=Synchronize current Certbot certificate into the web origin
{% if certbot_deploy_container_name is defined %}
After=docker.service
Requires=docker.service
{% endif %}

[Service]
Type=oneshot
Environment="RENEWED_LINEAGE=/etc/letsencrypt/live/{{ certbot_lineage_name | default(certbot_domains[0]) }}"
ExecStart=/etc/letsencrypt/renewal-hooks/deploy/reload-webserver.sh
