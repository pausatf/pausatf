# ModSecurity Configuration
# Managed by Ansible - Do not edit manually

# Rule engine: On (blocking), DetectionOnly (logging), Off
SecRuleEngine {{ modsecurity_rule_engine }}

# Request body handling
SecRequestBodyAccess {{ 'On' if modsecurity_request_body_access else 'Off' }}

SecRule REQUEST_HEADERS:Content-Type "(?:application(?:/soap\+|/)|text/)xml" \
     "id:'200000',phase:1,t:none,t:lowercase,pass,nolog,ctl:requestBodyProcessor=XML"

SecRule REQUEST_HEADERS:Content-Type "application/json" \
     "id:'200001',phase:1,t:none,t:lowercase,pass,nolog,ctl:requestBodyProcessor=JSON"

SecRequestBodyLimit {{ modsecurity_request_body_limit }}
SecRequestBodyNoFilesLimit {{ modsecurity_request_body_nofiles_limit }}
SecRequestBodyInMemoryLimit {{ modsecurity_request_body_inmemory_limit }}
SecRequestBodyLimitAction {{ modsecurity_request_body_limit_action }}

SecRule REQBODY_ERROR "!@eq 0" \
"id:'200002', phase:2,t:none,log,deny,status:400,msg:'Failed to parse request body.',logdata:'%{reqbody_error_msg}',severity:2"

SecRule MULTIPART_STRICT_ERROR "!@eq 0" \
"id:'200003',phase:2,t:none,log,deny,status:400, \
msg:'Multipart request body failed strict validation: \
PE %{REQBODY_PROCESSOR_ERROR}, \
BQ %{MULTIPART_BOUNDARY_QUOTED}, \
BW %{MULTIPART_BOUNDARY_WHITESPACE}, \
DB %{MULTIPART_DATA_BEFORE}, \
DA %{MULTIPART_DATA_AFTER}, \
HF %{MULTIPART_HEADER_FOLDING}, \
LF %{MULTIPART_LF_LINE}, \
SM %{MULTIPART_MISSING_SEMICOLON}, \
IQ %{MULTIPART_INVALID_QUOTING}, \
IP %{MULTIPART_INVALID_PART}, \
IH %{MULTIPART_INVALID_HEADER_FOLDING}, \
FL %{MULTIPART_FILE_LIMIT_EXCEEDED}'"

SecRule MULTIPART_UNMATCHED_BOUNDARY "!@eq 0" \
"id:'200004',phase:2,t:none,log,deny,msg:'Multipart parser detected a possible unmatched boundary.'"

# PCRE tuning
SecPcreMatchLimit {{ modsecurity_pcre_match_limit }}
SecPcreMatchLimitRecursion {{ modsecurity_pcre_match_limit_recursion }}

SecRule TX:/^MSC_/ "!@streq 0" \
        "id:'200005',phase:2,t:none,deny,msg:'ModSecurity internal error flagged: %{MATCHED_VAR_NAME}'"

# Response body handling
SecResponseBodyAccess {{ 'On' if modsecurity_response_body_access else 'Off' }}
SecResponseBodyMimeType {{ modsecurity_response_body_mime_types }}
SecResponseBodyLimit {{ modsecurity_response_body_limit }}
SecResponseBodyLimitAction {{ modsecurity_response_body_limit_action }}

# Filesystem
SecTmpDir {{ modsecurity_tmp_dir }}
SecDataDir {{ modsecurity_data_dir }}

# Audit logging
SecAuditEngine {{ modsecurity_audit_engine }}
SecAuditLogRelevantStatus {{ modsecurity_audit_log_relevant_status }}
SecAuditLogParts {{ modsecurity_audit_log_parts }}
SecAuditLogType {{ modsecurity_audit_log_type }}
SecAuditLog {{ modsecurity_audit_log }}

# Misc
SecArgumentSeparator {{ modsecurity_argument_separator }}
SecCookieFormat {{ modsecurity_cookie_format }}
SecUnicodeMapFile {{ modsecurity_unicode_map_file }}
SecStatusEngine {{ 'On' if modsecurity_status_engine else 'Off' }}
