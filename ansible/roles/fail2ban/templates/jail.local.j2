# Fail2ban Configuration
# Managed by Ansible - Do not edit manually

[DEFAULT]
bantime = {{ fail2ban_bantime }}
findtime = {{ fail2ban_findtime }}
maxretry = {{ fail2ban_maxretry }}
ignoreip = 127.0.0.1/8 ::1

# Email notifications
destemail = {{ fail2ban_destemail }}
sendername = {{ fail2ban_sendername }}
mta = {{ fail2ban_mta }}
action = %(action_)s

[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = 3

[apache-auth]
enabled = {{ 'true' if web_server | default('apache') == 'apache' else 'false' }}
port = http,https
filter = apache-auth
logpath = /var/log/apache2/*error.log
maxretry = 6

[apache-badbots]
enabled = {{ 'true' if web_server | default('apache') == 'apache' else 'false' }}
port = http,https
filter = apache-badbots
logpath = /var/log/apache2/*access.log
maxretry = 2

[apache-noscript]
enabled = {{ 'true' if web_server | default('apache') == 'apache' else 'false' }}
port = http,https
filter = apache-noscript
logpath = /var/log/apache2/*error.log
maxretry = 6

[apache-overflows]
enabled = {{ 'true' if web_server | default('apache') == 'apache' else 'false' }}
port = http,https
filter = apache-overflows
logpath = /var/log/apache2/*error.log
maxretry = 2

[openlitespeed-auth]
enabled = {{ 'true' if web_server | default('') == 'openlitespeed' else 'false' }}
port = http,https
filter = openlitespeed-auth
logpath = /usr/local/lsws/logs/error.log
maxretry = 6

[wordpress-auth]
enabled = true
port = http,https
filter = wordpress-auth
logpath = /var/log/auth.log
maxretry = 5
bantime = 3600

[wordpress-enum]
enabled = true
port = http,https
filter = wordpress-enum
logpath = /var/log/apache2/pausatf-main-ssl-access.log
maxretry = 1
bantime = 86400

[wordpress-hard]
enabled = true
port = http,https
filter = wordpress-auth
logpath = /var/log/auth.log
maxretry = 2
bantime = 86400

[wordpress-soft]
enabled = true
port = http,https
filter = wordpress-auth
logpath = /var/log/auth.log
maxretry = 5
bantime = 3600
