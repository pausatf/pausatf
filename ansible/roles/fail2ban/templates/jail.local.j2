# Fail2ban Configuration
# Managed by Ansible - Do not edit manually

[DEFAULT]
bantime = {{ fail2ban_bantime }}
findtime = {{ fail2ban_findtime }}
maxretry = {{ fail2ban_maxretry }}
ignoreip = 127.0.0.1/8 ::1

# Email notifications
destemail = {{ fail2ban_destemail }}
sendername = {{ fail2ban_sendername }}
mta = {{ fail2ban_mta }}
action = %(action_)s

[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = 3
{% if fail2ban_abuseipdb_enabled and fail2ban_abuseipdb_apikey %}
action = %(action_)s
         abuseipdb[abuseipdb_apikey="{{ fail2ban_abuseipdb_apikey }}", abuseipdb_category="18,22"]
{% endif %}

[apache-auth]
enabled = {{ 'true' if web_server | default('apache') == 'apache' else 'false' }}
port = http,https
filter = apache-auth
logpath = /var/log/apache2/*error.log
maxretry = 6
{% if fail2ban_abuseipdb_enabled and fail2ban_abuseipdb_apikey %}
action = %(action_)s
         abuseipdb[abuseipdb_apikey="{{ fail2ban_abuseipdb_apikey }}", abuseipdb_category="18,21"]
{% endif %}

[apache-badbots]
enabled = {{ 'true' if web_server | default('apache') == 'apache' else 'false' }}
port = http,https
filter = apache-badbots
logpath = /var/log/apache2/*access.log
maxretry = 2
{% if fail2ban_abuseipdb_enabled and fail2ban_abuseipdb_apikey %}
action = %(action_)s
         abuseipdb[abuseipdb_apikey="{{ fail2ban_abuseipdb_apikey }}", abuseipdb_category="19,21"]
{% endif %}

[apache-noscript]
enabled = {{ 'true' if web_server | default('apache') == 'apache' else 'false' }}
port = http,https
filter = apache-noscript
logpath = /var/log/apache2/*error.log
maxretry = 6

[apache-overflows]
enabled = {{ 'true' if web_server | default('apache') == 'apache' else 'false' }}
port = http,https
filter = apache-overflows
logpath = /var/log/apache2/*error.log
maxretry = 2

[openlitespeed-auth]
enabled = {{ 'true' if web_server | default('') == 'openlitespeed' else 'false' }}
port = http,https
filter = openlitespeed-auth
logpath = /usr/local/lsws/logs/error.log
maxretry = 6

[wordpress-auth]
enabled = true
port = http,https
filter = wordpress-auth
logpath = /var/log/syslog
maxretry = 3
findtime = 300
bantime = 7200
{% if fail2ban_abuseipdb_enabled and fail2ban_abuseipdb_apikey %}
action = %(action_)s
         abuseipdb[abuseipdb_apikey="{{ fail2ban_abuseipdb_apikey }}", abuseipdb_category="18,21"]
{% endif %}

