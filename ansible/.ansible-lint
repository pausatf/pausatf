---
# Brownfield baseline: demote cosmetic/compatibility violations to warnings.
# Security- and correctness-critical rules remain as errors.
# Fix incrementally via targeted refactor tasks.

warn_list:
  # FQCN: short module names still resolve correctly in this context.
  - fqcn[action-core]
  - fqcn[action]
  # Truthy: 'yes'/'no' are unambiguous in Ansible's own YAML parser.
  - truthy
  # Naming: brownfield task names not capitalised.
  - name[casing]
  - name[play]
  # local_action: deprecated but functional in ansible-core <2.23.
  - local-action
  # These are intentional patterns in this codebase; fix in future sprint.
  - ignore-errors
  - no-changed-when
  - risky-file-permissions
  - risky-shell-pipe
  - command-instead-of-module
  - command-instead-of-shell
  # YAML style: handled separately by yamllint with a project config.
  - yaml[indentation]
  - yaml[new-line-at-end-of-file]
  - yaml[trailing-spaces]
  - yaml[comments]
  - yaml[truthy]
  - yaml[octal-values]
  - yaml[line-length]
