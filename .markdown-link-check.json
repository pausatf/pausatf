{
  "ignorePatterns": [
    {
      "pattern": "^http://localhost"
    },
    {
      "pattern": "^https://localhost"
    },
    {
      "pattern": "^https://www.gnu.org/"
    },
    {
      "pattern": "^https://github.com/pausatf/pausatf-(terraform|infrastructure-docs|ansible|legacy-content|scripts)"
    },
    {
      "pattern": "^LICENSE$"
    },
    {
      "pattern": "PERFORMANCE_OPTIMIZATION_REPORT\\.md$"
    },
    {
      "pattern": "tests/README\\.md$"
    },
    {
      "pattern": "themes/thesource-child/CHANGELOG\\.md$"
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [
    200,
    206
  ]
}
