<?xml version="1.0"?>
<ruleset name="PAUSATF WordPress Standards">
  <description>WordPress Coding Standards for themes and custom plugins</description>

  <file>themes</file>
  <file>wp-content/plugins</file>

  <exclude-pattern>themes/thesource/core/*</exclude-pattern>
  <exclude-pattern>themes/thesource/epanel/*</exclude-pattern>
  <exclude-pattern>themes/thesource/includes/*</exclude-pattern>

  <rule ref="WordPress-Core"/>
  <rule ref="WordPress-Docs"/>
  <rule ref="WordPress-Extra"/>
  <rule ref="PHPCompatibility"/>

  <config name="testVersion" value="8.0-8.3"/>

  <arg name="extensions" value="php"/>
  <arg value="s"/>
  <arg value="p"/>
</ruleset>
