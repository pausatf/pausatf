---
# Brownfield baseline: demote cosmetic/compatibility violations to warnings.
# Security- and correctness-critical rules remain errors.

warn_list:
  # FQCN: short names still resolve correctly in this context.
  - fqcn[action-core]
  - fqcn[action]
  # Truthy: yes/no are unambiguous in Ansible's YAML parser.
  - truthy
  # Naming: brownfield tasks not capitalised; Jinja in name allowed.
  - name[casing]
  - name[play]
  - name[template]
  # local_action: deprecated but functional in ansible-core <2.23.
  - deprecated-local-action
  # Task key order: cosmetic.
  - key-order[task]
  # Role variable naming prefix: brownfield pre-dates prefix convention.
  - var-naming[no-role-prefix]
  - var-naming
  # Document start "---": many files predate this convention.
  - yaml[document-start]
  # Intentional patterns in this codebase; fix in future sprint.
  - ignore-errors
  - no-changed-when
  - risky-file-permissions
  - risky-shell-pipe
  - command-instead-of-module
  - command-instead-of-shell
  # YAML style: handled by yamllint with project config.
  - yaml[indentation]
  - yaml[new-line-at-end-of-file]
  - yaml[trailing-spaces]
  - yaml[comments]
  - yaml[truthy]
  - yaml[octal-values]
  - yaml[line-length]
  - yaml[empty-lines]
  - yaml[braces]
  # Jinja spacing: cosmetic.
  - jinja[spacing]
  # args[module]: static validation can't evaluate Jinja2 templates.
  - args[module]
