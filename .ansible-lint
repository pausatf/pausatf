---
# Brownfield baseline — security/correctness rules remain errors.
# Cosmetic rules moved to skip_list (warn_list exits 2 in ansible-lint v25).

exclude_paths:
  # Cloud-init is Terraform-rendered, not Ansible — skip linting.
  - terraform/modules/droplet/cloud-init-base.yml
  - terraform/modules/droplet/cloud-init-openlitespeed.yml
  - terraform/modules/droplet/cloud-init-ubuntu-24.yml
  # Dynamic inventory generated by Terraform; not a playbook.
  - terraform/environments/github/inventory.yml

skip_list:
  # FQCN: short names resolve correctly; brownfield convention.
  - fqcn[action-core]
  - fqcn[action]
  # Truthy: yes/no unambiguous in Ansible YAML parser.
  - truthy
  # Naming: brownfield tasks predate capitalization convention.
  - name[casing]
  - name[play]
  - name[template]
  # local_action: deprecated but functional in ansible-core <2.23.
  - deprecated-local-action
  # Task key order: cosmetic.
  - key-order[task]
  # Role variable prefix: brownfield predates prefix convention.
  - var-naming[no-role-prefix]
  - var-naming
  # Document start: many files predate this convention.
  - yaml[document-start]
  # Intentional patterns; address in future sprint.
  - ignore-errors
  - no-changed-when
  - risky-file-permissions
  - risky-shell-pipe
  - command-instead-of-module
  - command-instead-of-shell
  # YAML style: handled by yamllint with project config.
  - yaml[indentation]
  - yaml[new-line-at-end-of-file]
  - yaml[trailing-spaces]
  - yaml[comments]
  - yaml[truthy]
  - yaml[octal-values]
  - yaml[line-length]
  - yaml[empty-lines]
  - yaml[braces]
  # Jinja spacing: cosmetic.
  - jinja[spacing]
  # args[module]: static analysis can't evaluate Jinja2 templates.
  - args[module]
  # role-name: php-fpm uses hyphen (established name; renaming would break references).
  - role-name
  # no-handler: apt cache update must run immediately after repo add, not at play end.
  - no-handler
